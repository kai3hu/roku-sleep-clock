<?xml version="1.0" encoding="utf-8" ?>
<component name="NightScheduleScene" extends="Scene">
    <interface>
        <field id="interactive" type="boolean" value="false" />
        <field id="lastExitReason" type="string" value="Unknown" />
    </interface>
    <children>
        <Rectangle id="blackBackground" width="1920" height="1080" color="0x000000FF" />
        <Group id="content" translation="[120,80]">
            <Label id="clockPrevious" width="760" height="185" opacity="0" color="0x0C0C0CFF">
                <Font role="font" uri="font:SystemFontFile" size="110" />
            </Label>
            <Label id="clock" width="600" height="150" color="0x0C0C0CFF">
                <Font role="font" uri="font:SystemFontFile" size="110" />
            </Label>
            <Label id="clockPeriod" width="110" height="65" visible="false" color="0x0C0C0CFF">
                <Font role="font" uri="font:SystemFontFile" size="28" />
            </Label>
            <Label id="today" translation="[12,155]" width="900" height="50" text="TODAY  /  Loading calendar..." color="0x0C0C0CFF">
                <Font role="font" uri="font:SystemFontFile" size="30" />
            </Label>
            <Label id="todayBody" translation="[12,215]" width="900" height="330" wrap="true" numLines="7" color="0x0C0C0CFF">
                <Font role="font" uri="font:SystemFontFile" size="34" />
            </Label>
            <Label
                id="heading"
                translation="[12,555]"
                width="880"
                height="55"
                text="NEXT 7 DAYS"
                color="0x0C0C0CFF">
                <Font role="font" uri="font:SystemFontFile" size="26" />
            </Label>
            <Label
                id="agenda"
                translation="[12,610]"
                width="900"
                height="305"
                wrap="true"
                numLines="8"
                color="0x0C0C0CFF">
                <Font role="font" uri="font:SystemFontFile" size="24" />
            </Label>
            <Group id="weather" translation="[1000,10]">
                <Label id="weatherLocation" width="650" height="45" text="TUSCALOOSA" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="28" />
                </Label>
                <Poster id="weatherIcon" blendColor="0x555555FF" translation="[0,55]" width="96" height="96" loadDisplayMode="scaleToFit" visible="false" />
                <Label id="temperature" translation="[125,45]" width="390" height="100" text="--°C" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="60" />
                </Label>
                <Label id="weatherDescription" translation="[0,160]" width="550" height="50" text="Loading weather..." color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="28" />
                </Label>
                <Label id="weatherForecastHeading" translation="[0,220]" width="650" height="45" text="NEXT 24 HOURS" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="28" />
                </Label>
                <Label id="weatherRange" translation="[0,270]" width="650" height="40" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="24" />
                </Label>
                <Group id="weatherChart" translation="[0,330]" />
                <Group id="weatherForecast" translation="[0,520]" />
                <Label translation="[0,780]" width="650" height="35" text="Weather: Open-Meteo (CC BY 4.0)" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="18" />
                </Label>
            </Group>
            <Group id="news" visible="false" translation="[12,190]">
                <Label id="newsHeading" width="1656" height="45" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="28" />
                </Label>
                <Label id="newsTitle" translation="[0,75]" width="1656" height="135" wrap="true" numLines="2" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="52" />
                </Label>
                <Label id="newsSummary" translation="[0,230]" width="1656" height="330" wrap="true" numLines="8" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="32" />
                </Label>
                <Label id="newsUrl" translation="[0,590]" width="1656" height="65" wrap="true" numLines="2" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="20" />
                </Label>
                <Label id="newsAttribution" translation="[0,665]" width="1656" height="35" text="Kagi News / AI-generated summary, shortened / CC BY-NC 4.0: creativecommons.org/licenses/by-nc/4.0/" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="20" />
                </Label>
            </Group>
            <Group id="telegram" visible="false" translation="[12,155]">
                <Label id="telegramHeading" width="1656" height="45" text="TELEGRAM  /  @DNSPODT" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="28" />
                </Label>
                <Group id="telegramGrid" translation="[0,55]" />
                <Label id="telegramStatus" translation="[0,710]" width="1656" height="35" color="0x0C0C0CFF">
                    <Font role="font" uri="font:SystemFontFile" size="20" />
                </Label>
                <Label id="telegramAttribution" translation="[0,750]" width="1656" height="35" color="0x0C0C0CFF">
                    <Font role="font" uri="pkg:/fonts/NotoSansSC-Regular.otf" size="18" fallbackGlyph="u0020" />
                </Label>
            </Group>
        </Group>
        <Timer id="tick" duration="1" repeat="true" />
        <Animation id="clockTransition" duration="0.24" repeat="false" easeFunction="linear">
            <FloatFieldInterpolator id="clockIn" key="[0,1]" keyValue="[0,1]" fieldToInterp="clock.opacity" />
            <FloatFieldInterpolator id="clockOut" key="[0,1]" keyValue="[1,0]" fieldToInterp="clockPrevious.opacity" />
            <Vector2DFieldInterpolator id="clockLift" key="[0,1]" keyValue="[[0,0],[0,0]]" fieldToInterp="clock.translation" />
            <Vector2DFieldInterpolator id="clockDrop" key="[0,1]" keyValue="[[0,0],[0,0]]" fieldToInterp="clockPrevious.translation" />
        </Animation>
        <Timer id="refresh" duration="300" repeat="true" />
        <Timer id="agendaPageTimer" duration="20" repeat="true" />
        <Timer id="rotationTimer" duration="120" repeat="false" />
        <CalendarTask id="calendarTask" />
        <WeatherTask id="weatherTask" />
        <NewsTask id="newsTask" />
        <TelegramTask id="telegramTask" />
    </children>
    <script type="text/brightscript" uri="pkg:/source/config.brs" />
    <script type="text/brightscript" uri="pkg:/components/DisplaySchedule.brs" />
    <script type="text/brightscript" uri="pkg:/components/SharedContent.brs" />
    <script type="text/brightscript" uri="pkg:/components/TelegramContent.brs" />
    <script type="text/brightscript" uri="pkg:/components/AppSettings.brs" />
    <script type="text/brightscript" uri="pkg:/components/AppClock.brs" />
    <script type="text/brightscript" uri="pkg:/components/AppMenu.brs" />
    <script type="text/brightscript" uri="pkg:/components/AppKeepRunning.brs" />
    <script type="text/brightscript" uri="pkg:/components/AppControls.brs" />
    <script type="text/brightscript" uri="pkg:/components/NightScheduleScene.brs" />
</component>
